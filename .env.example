# ─── Required secrets ────────────────────────────────────────────────────────
# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Telegram bot token from @BotFather, and your chat ID (see README step 2-3).
# OPTIONAL: leave both blank (or set TELEGRAM_NOTIFICATIONS=off below) to skip
# Telegram entirely — relevant jobs still appear in the web GUI.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=987654321

# Set to "off" to disable Telegram push notifications even if credentials are set.
# TELEGRAM_NOTIFICATIONS=off

# ─── Optional knobs (defaults shown — uncomment to override) ─────────────────
# Claude model used to score job relevance (cheap/fast model recommended)
# ANALYZER_MODEL=claude-haiku-4-5

# Claude model used to write cover letters (stronger model recommended)
# COVER_LETTER_MODEL=claude-opus-5

# Minimum AI score (1-10) for a job to count as relevant
# MIN_RELEVANCE_SCORE=4

# How often the scheduler runs (node-cron syntax). Default: hourly at :00
# CRON_SCHEDULE=0 * * * *

# A notified job not seen in any scrape for this many hours is marked expired
# EXPIRY_THRESHOLD_HOURS=72

# Set to "off" to stop Telegram alerts for expired jobs (new-job alerts still fire)
# EXPIRY_NOTIFICATIONS=off

# Parallel Claude analysis requests (raise carefully — watch rate limits)
# ANALYSIS_CONCURRENCY=2

# Parallel browser workers when scraping sources (one browser each)
# SCRAPE_CONCURRENCY=4

# Parallel tabs when fetching job descriptions. Requests are spread across hosts,
# so this is a global number — no site sees more than one request at a time
# regardless of how high it goes. Defaults to 8.
# DESC_CONCURRENCY=8

# Minimum pause between two requests to the SAME host, in ms (plus jitter).
# This is the setting that keeps us off bot-detection radar — raise it, not the
# concurrency, if a site starts blocking.
# SOURCE_HOST_GAP_MS=2000
# DESC_HOST_GAP_MS=1500
# PLATFORM_DESC_HOST_GAP_MS=2500

# Port for the web GUI (npm run gui)
# GUI_PORT=3000

# Grace period for "Lauf stoppen" before a run is force-killed (milliseconds).
# RUN_STOP_GRACE_MS=45000

# Show the multi-client UI (Klienten tab + client selector in the top bar).
# Off = private single-user view; everything runs on the default client.
# CLIENTS_ENABLED=false

# ─── Auto-Bewerbung (Einfach bewerben / Easy Apply) ──────────────────────────
# Global kill switch — nothing is prepared or submitted while this is off.
# AUTO_APPLY_ENABLED=false

# Key for encrypting platform credentials at rest (64 hex chars).
# Generate once: npm run generate-credentials-key
# CREDENTIALS_KEY=

# Dry run: fill the application forms completely but NEVER click the final
# submit (a screenshot is saved instead). Keep on until you trust the flow.
# APPLY_DRY_RUN=true

# Max submitted applications per client, platform and day (LinkedIn/Indeed are
# additionally hard-capped at 5) + minimum minutes between two submissions.
# APPLY_DAILY_CAP=10
# APPLY_COOLDOWN_MINUTES=15

# Show the apply browser window (needed once per platform for logins that ask
# for 2FA/e-mail codes; only useful on a machine with a display).
# APPLY_HEADFUL=false
